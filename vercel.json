{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(?!api(?:/|$))([a-z0-9-]+(?:/[a-z0-9-]+)*)/?$", "dest": "/$1.html", "check": true },
    { "src": "/(?!api(?:/|$)).*", "dest": "/404.html", "status": 404 }
  ]
}
